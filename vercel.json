{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "landing",
  "installCommand": "true",
  "buildCommand": "true",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "master": true
    }
  }
}
